{
  "name": "pixelmon",
  "version": "0.1.0",
  "private": true,
  "description": "Pixelmon (Voxel Legends) — voxel creature-catching game in Next.js",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node server.js",
    "generate-catalogs": "node scripts/generate-pokemon-catalogs.cjs",
    "generate-pokemons-md": "node scripts/generate-pokemons-md.cjs",
    "build-slim": "node scripts/build-slim.cjs",
    "setup-data": "node scripts/migrate-to-sqlite.js",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" eslint.config.mjs package.json",
    "format:write": "prettier --write \"src/**/*.{js,jsx}\" eslint.config.mjs package.json",
    "generate:assets": "node scripts/generate-asset-manifest.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:server": "node --test src/server/test/**/*.test.js",
    "test:ui": "vitest run",
    "test:ui:coverage": "vitest run --coverage",
    "test:ui:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "^16.2.10",
    "node-cache": "^5.1.2",
    "puppeteer": "^25.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "three": "^0.172.0",
    "three-html-render": "^0.1.2",
    "ts-chacha20": "^1.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
