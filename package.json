{
  "name": "pixelmon",
  "version": "0.1.0",
  "private": true,
  "description": "Pixelmon (Voxel Legends) — voxel creature-catching game",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "test": "npm test --prefix server && npm test --prefix client -- --run",
    "generate-catalogs": "node scripts/generate-pokemon-catalogs.js",
    "generate-pokemons-md": "node scripts/generate-pokemons-md.js",
    "build-slim": "node scripts/build-slim.js",
    "setup-data": "npm run generate-catalogs && npm run generate-pokemons-md && npm run build-slim",
    "generate:assets": "node scripts/generate-asset-manifest.js",
    "br:server": "node server/src/index.js",
    "lint": "eslint client/src server/src",
    "lint:fix": "eslint client/src server/src --fix",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0"
  }
}